#!/usr/bin/env bash
set -euo pipefail

{{ if eq .chezmoi.os "darwin" -}}
# ── Homebrew packages ─────────────────────────────────────────────────────────
BREW_PACKAGES=(zsh tmux)

# ── Xcode Command Line Tools ──────────────────────────────────────────────────
if ! xcode-select -p &>/dev/null; then
  echo "==> Installing Xcode Command Line Tools..."
  xcode-select --install
  # Wait for installation to complete
  until xcode-select -p &>/dev/null; do sleep 5; done
fi

# ── Homebrew ──────────────────────────────────────────────────────────────────
if ! command -v brew &>/dev/null; then
  echo "==> Installing Homebrew..."
  /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"

  # Add brew to PATH for the remainder of this script
  if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
fi

# ── Homebrew packages ─────────────────────────────────────────────────────────
echo "==> Installing packages via brew..."
brew install "${BREW_PACKAGES[@]}"

{{ else if eq .chezmoi.os "linux" -}}
# ── Detect package manager and install dependencies ───────────────────────────
PACKAGES=(curl unzip fontconfig zsh tmux)

if command -v apt-get &>/dev/null; then
  echo "==> Installing dependencies via apt..."
  sudo apt-get update -qq
  sudo apt-get install -y "${PACKAGES[@]}"

elif command -v dnf &>/dev/null; then
  echo "==> Installing dependencies via dnf..."
  sudo dnf install -y "${PACKAGES[@]}"

elif command -v pacman &>/dev/null; then
  echo "==> Installing dependencies via pacman..."
  sudo pacman -S --noconfirm --needed "${PACKAGES[@]}"

elif command -v zypper &>/dev/null; then
  echo "==> Installing dependencies via zypper..."
  sudo zypper install -y "${PACKAGES[@]}"

else
  echo "ERROR: No supported package manager found (apt, dnf, pacman, zypper)." >&2
  exit 1
fi

{{ end -}}

echo "==> Dependencies OK."
